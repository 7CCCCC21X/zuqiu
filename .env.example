# predict.fun REST/WS api key (open a ticket in the predict.fun Discord to get one; testnet needs none)
PREDICT_API_KEY=
# private key that signs orders.
#  - EOA: the wallet's private key
#  - Predict account (web app smart wallet): the Privy wallet private key exported at https://predict.fun/account/settings
PREDICT_PRIVATE_KEY=
# only when using a Predict account: the deposit / account address shown in account settings
PREDICT_ACCOUNT=
# https://the-odds-api.com api key
ODDS_API_KEY=
# optional BNB chain RPC (faster confirmations for merges / approvals)
RPC_URL=
