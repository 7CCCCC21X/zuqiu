{
  "name": "predict-football-mm",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-match two-sided market-making bot for predict.fun football markets (odds-linked YES/NO bids + pair merging)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/index.js run",
    "dev": "tsc -p tsconfig.json && node dist/index.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@predictdotfun/sdk": "1.3.8",
    "ethers": "^6.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
